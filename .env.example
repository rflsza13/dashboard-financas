# Copie para .env e preencha (reinicie o `npm start` depois de editar).
# No Vercel, cadastre as mesmas variáveis em Settings > Environment Variables e faça um novo deploy.

# URL do web app publicado no Google Apps Script (termina em /exec)
REACT_APP_SCRIPT_URL=
# Client ID do Google (Cloud Console > Credenciais > ID do cliente OAuth, tipo "Aplicativo da Web").
# Ativa a tela de login. Precisa ser o mesmo CLIENT_ID do Code.gs.
REACT_APP_GOOGLE_CLIENT_ID=

# OPCIONAL e SÓ para desenvolvimento local sem login: senha fixa igual à constante TOKEN do Code.gs.
# Não use em produção (a senha ficaria visível no código do site).
# REACT_APP_SCRIPT_TOKEN=
